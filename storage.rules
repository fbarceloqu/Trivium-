// Se despliega desde firebase.json:  firebase deploy --only storage
//
// Las lecturas de la tablet y del alumno usan firestore.get(), y eso exige que
// el agente de servicio de Storage tenga el rol
// roles/firebaserules.firestoreServiceAgent. La CLI solo lo concede en un
// deploy interactivo. Sin ese rol esas dos ramas fallan cerradas (niegan); el
// padre no depende de ellas.

rules_version = '2';

// Reglas de Firebase Storage para Trivium.
//
// Aquí solo viven las guías y materiales que suben los padres. La lista blanca
// debe coincidir con la de android/firestore.rules y con ALLOWED_PARENT_EMAILS
// en dashboard/app.js.
//
// Las tablets LEEN el material (para analizarlo) pero no escriben: el material
// lo aporta el padre. Nadie sin autenticar toca nada.
service firebase.storage {
  match /b/{bucket}/o {

    function isParent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in [
          'fco.quintanar@gmail.com',
          'anaid.torresu@gmail.com'
        ];
    }
    function isStudentOwner(childId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && firestore.get(/databases/(default)/documents/children/$(childId)).data.authorizedEmail
          == request.auth.token.email;
    }
    function isDeviceOwner(childId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && firestore.get(/databases/(default)/documents/children/$(childId)).data.deviceUid
          == request.auth.uid;
    }

    match /guides/{childId}/{fileName} {
      allow read: if isParent() || isStudentOwner(childId) || isDeviceOwner(childId);
      // Tope de 15 MB: una guía escaneada cabe de sobra y evita que un archivo
      // enorme se lleve la cuota gratuita por accidente.
      allow write: if isParent() && request.resource.size < 15 * 1024 * 1024;
    }

    // Todo lo demás, bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
