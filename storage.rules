// NO DESPLEGADO TODAVIA
// ======================
// Cloud Storage exige plan Blaze (tarjeta a la vista) incluso sin gastar nada,
// asi que este archivo esta escrito pero NO referenciado desde firebase.json.
//
// No hace falta: en las guias el archivo adjunto es OPCIONAL; lo que alimenta
// el motor son los temas. Sin Storage el panel funciona completo.
//
// Para activarlo el dia que se pase a Blaze:
//   1. Consola Firebase -> Storage -> Comenzar
//   2. Anadir a firebase.json:  "storage": { "rules": "storage.rules" }
//   3. firebase deploy --only storage

rules_version = '2';

// Reglas de Firebase Storage para Trivium.
//
// Aquí solo viven las guías y materiales que suben los padres. La lista blanca
// debe coincidir con la de android/firestore.rules y con ALLOWED_PARENT_EMAILS
// en dashboard/app.js.
//
// Las tablets LEEN el material (para analizarlo) pero no escriben: el material
// lo aporta el padre. Nadie sin autenticar toca nada.
service firebase.storage {
  match /b/{bucket}/o {

    function isParent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in [
          'fco.quintanar@gmail.com',
          'anaid.torresu@gmail.com'
        ];
    }
    function isTablet() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /guides/{childId}/{fileName} {
      allow read: if isParent() || isTablet();
      // Tope de 15 MB: una guía escaneada cabe de sobra y evita que un archivo
      // enorme se lleve la cuota gratuita por accidente.
      allow write: if isParent() && request.resource.size < 15 * 1024 * 1024;
    }

    // Todo lo demás, bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
