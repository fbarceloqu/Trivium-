{
  "hosting": {
    "public": "dashboard",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firebase-config.example.js"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "android/firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
