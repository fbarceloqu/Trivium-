rules_version = '2';
// Reglas Fase A de Trivium: las tablets (sesión anónima) pueden escribir el
// progreso de su propio niño. Nadie sin autenticar puede leer ni escribir.
// En la Fase B (dashboard web con login del padre) se restringirá la lectura
// al UID del padre y la escritura de cada tablet a su propio childId.
service cloud.firestore {
  match /databases/{database}/documents {
    match /children/{childId} {
      allow read, write: if request.auth != null;
      match /days/{day} {
        allow read, write: if request.auth != null;
      }
    }
    // Todo lo demás, bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
