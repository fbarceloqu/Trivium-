rules_version = '2';
// Reglas de Trivium (Fase B):
// - Las TABLETS entran con sesión anónima y escriben el progreso/respaldo.
// - El PADRE entra con Google (Google Sign-In) desde el Panel web, y SOLO si
//   su correo está en la lista blanca de abajo, puede leerlo todo.
// Nadie sin autenticar puede leer ni escribir.
//
// IMPORTANTE: mantén esta lista sincronizada con ALLOWED_PARENT_EMAILS en
// dashboard/app.js. Esta es la defensa real (las reglas del cliente se pueden
// saltar); la del cliente solo evita mostrar la UI a quien no debe.
//
service cloud.firestore {
  match /databases/{database}/documents {

    function isParent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in [
          'fco.quintanar@gmail.com',
          'anaid.torresu@gmail.com'
        ];
    }
    function isTablet() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isStudent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && !isParent();
    }
    // get(campo, valor por defecto) en todas partes: leer un campo que no
    // existe es un ERROR en las reglas, y un error niega la operación. Los
    // perfiles viejos no tienen deviceUid y algunos no tienen authorizedEmail.
    function isStudentOwner(childId) {
      return isStudent()
        && get(/databases/$(database)/documents/children/$(childId)).data.get('authorizedEmail', '')
          == request.auth.token.email;
    }
    // Una tablet anónima solo ESCRIBE en el perfil al que está ligada
    // (deviceUid, lo guarda ProgressSync.registerChild()).
    function isDeviceOwner(childId) {
      return isTablet()
        && get(/databases/$(database)/documents/children/$(childId)).data.get('deviceUid', '')
          == request.auth.uid;
    }
    // Tablet ya ligada, o tablet que se liga a un perfil que aún no tiene
    // dueño. Los perfiles creados antes del deviceUid no lo tienen: sin esto,
    // las tablets que ya estaban en uso no podrían volver a escribir nunca.
    // Para ligarse hay que conocer el ID exacto del perfil, y ya nadie puede
    // listar perfiles ajenos.
    function isOwnerOrClaimingTablet() {
      return isTablet() && (
        resource.data.get('deviceUid', '') == request.auth.uid
        || (resource.data.get('deviceUid', '') == ''
          && request.resource.data.get('deviceUid', '') == request.auth.uid)
      );
    }
    function canUpdateOwnRoot() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'grade', 'pinVerifier', 'pinSalt', 'pinHash',
        'blockSettings', 'emergencyCalls', 'deviceUid', 'lastSeen', 'updatedAt'
      ]);
    }
    // El correo autorizado solo lo cambia el padre.
    function keepsAuthorizedEmail() {
      return request.resource.data.get('authorizedEmail', '')
        == resource.data.get('authorizedEmail', '');
    }

    match /children/{childId} {
      // Lectura de UN perfil por su ID. Cualquier tablet puede hacerla: tras
      // borrar los datos de la app, la sesión anónima es otra y la tablet
      // necesita leer su perfil para restaurar el PIN del padre. Si no, el
      // niño vería la pantalla de configuración y pondría su propio PIN.
      // Sin 'list', nadie puede enumerar ni descubrir IDs ajenos.
      allow get: if isParent() || isStudentOwner(childId) || isTablet();
      // Listar: el padre, o el alumno buscando SU perfil por correo
      // (StudentGoogleAuth). La consulta tiene que filtrar por authorizedEmail;
      // una regla con get() por documento no sirve para consultas.
      allow list: if isParent()
        || (isStudent() && resource.data.authorizedEmail == request.auth.token.email);
      allow create: if isParent() || (
        isTablet() && request.resource.data.deviceUid == request.auth.uid
      );
      allow update: if isParent() || (
        (isOwnerOrClaimingTablet() || isStudentOwner(childId))
        && canUpdateOwnRoot()
        && keepsAuthorizedEmail()
      );
      match /days/{day} {
        allow read, write: if isParent() || isDeviceOwner(childId) || isStudentOwner(childId);
      }
      // Memoria de aprendizaje: la tablet la escribe, el padre la lee para el
      // mapa de dominio. El padre NO escribe aquí: el dominio lo determina el
      // desempeño del niño, no lo que un adulto declare.
      match /skills/{skillId} {
        allow read: if isParent() || isDeviceOwner(childId) || isStudentOwner(childId);
        allow write: if isDeviceOwner(childId) || isStudentOwner(childId);
      }
      // Guías subidas por el padre. Al revés que arriba: el padre las crea y
      // la tablet solo las lee para planificar el repaso.
      match /guides/{guideId} {
        allow read: if isParent() || isDeviceOwner(childId) || isStudentOwner(childId);
        allow write: if isParent();
      }
      // Detalle de una sesión: preguntas, respuesta elegida y explicación.
      // La tablet lo escribe; lo leen el padre y la propia tablet o alumno.
      match /days/{day}/sessions/{sessionId} {
        allow read: if isParent() || isDeviceOwner(childId) || isStudentOwner(childId);
        allow write: if isDeviceOwner(childId) || isStudentOwner(childId);
      }
    }

    // Todo lo demás, bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
